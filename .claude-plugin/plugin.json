{
  "name": "targetprocess-mcp",
  "displayName": "Targetprocess",
  "version": "2.6.4",
  "description": "MCP server connecting Claude to Targetprocess REST API",
  "author": {
    "name": "Serhii Maksymiv"
  },
  "repository": "https://github.com/SerhiiMaksymiv/targetprocess-mcp-server",
  "license": "ISC",
  "mcpServers": {
    "targetprocess": {
      "command": "node",
      "args": ["-y", "targetprocess-mcp-server"],
      "env": {
        "TP_BASE_URL": "${TP_BASE_URL}",
        "TP_TOKEN": "${TP_TOKEN}",
        "TP_OWNER_ID": "${TP_OWNER_ID}",
        "TP_PROJECT_ID": "${TP_PROJECT_ID}",
        "TP_TEAM_ID": "${TP_TEAM_ID}"
      }
    }
  }
}
